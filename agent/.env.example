# Copy to .env. Never commit .env.
# Only PAPER execution is implemented. LIVE is refused by the application.
TRADING_MODE=paper
EXCHANGE=binanceusdm
ANALYST_MODE=rules
SYMBOLS=BTCUSDT,ETHUSDT
DATABASE_URL=sqlite:///futures_agent.db
UNIVERSE_ENABLED=true
UNIVERSE_SIZE=20
UNIVERSE_MIN_VOLUME=50000000
HISTORY_DAYS=365
ENTRY_MARGIN_PCT=10
ENTRY_LEVERAGE=10
MAX_HOLD_MINUTES=60
STALLED_EXIT_MINUTES=30
MULTIFRAME_ENABLED=true
MULTIFRAME_BATCH_SIZE=8
CLOUD_DASHBOARD_URL=
CLOUD_DASHBOARD_TOKEN=

BYBIT_API_KEY=
BYBIT_API_SECRET=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
